# Copy these values to Railway Variables or a local .env file.
# Never commit your real API keys.
GOOGLE_MAPS_API_KEY=
SQUARESPACE_API_KEY=

# Warehouse coordinates/name (defaults are currently Erode-area coordinates).
ORIGIN_LATITUDE=11.3410
ORIGIN_LONGITUDE=77.7172
ORIGIN_NAME=Delivery Warehouse

# PRICING
# Keep placeholder_distance_weight until actual transporter rates are confirmed.
# Supported: placeholder_distance_weight, flat_rate, distance_only, weight_only, hybrid
PRICING_MODE=placeholder_distance_weight
PLACEHOLDER_RATE_PER_KG_KM=0.50
BASE_CHARGE_INR=0
RATE_PER_KM_INR=0
RATE_PER_KG_INR=0
RATE_PER_KG_KM_INR=0
MINIMUM_CHARGE_INR=0

# SERVICEABILITY
# unrestricted = do not block PINs (coverage is not verified; testing only)
# allowlist = only SERVICEABLE_PINCODES are accepted
# denylist = BLOCKED_PINCODES are rejected
SERVICEABILITY_MODE=unrestricted
SERVICEABLE_PINCODES=
BLOCKED_PINCODES=
# Optional PINs that should stop and require business confirmation.
MANUAL_CONFIRMATION_PINCODES=
